# Cloud deployment config file used by deploy.sh
# Copy to .env.deploy.test or .env.deploy.prod
# Uncomment and configure for your cloud deploy
# Run ./deploy.sh or .\deploy.ps1 with --env test or --env prod

# For LOCAL DEVELOPMENT, use .env.example instead

# --- Slack app ---
# Required: Slack app credentials from your app at https://api.slack.com/apps
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=


# --- Cloud provider ---
# Required: cloud provider to deploy to, aws or gcp are currently supported
# CLOUD_PROVIDER=
# Optional: Keep app warm in cloud provider, default is true
# ENABLE_KEEP_WARM=true

# --- Cloud provider: configure this block for aws ---
# Optional: AWS region, default is us-east-1
# AWS_REGION=us-east-1
# Required: AWS stack name, convention is syncbot-test or syncbot-prod
# AWS_STACK_NAME=
# Optional: AWS bootstrap stack name, default is syncbot-bootstrap
# AWS_BOOTSTRAP_STACK_NAME=syncbot-bootstrap
# Optional: AWS X-Ray tracing, default is false, setting to true will cost
# AWS_ENABLE_XRAY=false

# --- Cloud provider: configure this block for gcp ---
# Optional: GCP region, default is us-central1
# GCP_REGION=us-central1
# Required: GCP project ID, must be a valid and globally unique project ID in your GCP account
# GCP_PROJECT_ID=
# Optional: GCP Cloud Run instances, default is 0 (scale-to-zero), setting to 1 is always-on and will cost
# GCP_CLOUD_RUN_MIN_INSTANCES=0


# --- Database ---
# Database backend, options are sqlite (default for GCP), mysql (default for AWS), or postgresql
# DATABASE_BACKEND=

# --- Database: configure this block for mysql or postgresql ---
# See docs/DEPLOY.md for more details
# DATABASE_HOST=
# Leave port blank for the backend default (3306 mysql, 5432 postgresql), TiDB Cloud uses 4000
# DATABASE_PORT=
# DATABASE_USER=
# DATABASE_PASSWORD=
# Database schema name, convention is syncbot_test or syncbot_prod
# DATABASE_SCHEMA=
# Database TLS encrypted connection, default is true
# DATABASE_TLS_ENABLED=true
# Optional: path to a TLS CA bundle (AWS CI and both deploy scripts support this)
# DATABASE_SSL_CA_PATH=


# --- Data encryption ---
# Set to a random long string, or leave empty to auto-generate on first deploy and have the value saved back to this file
# DATA_ENCRYPTION_KEY=


# --- CI/CD ---
# Optional: target GitHub owner/repo for --setup-github / CI/CD actions
# GITHUB_REPO=


# --- Optional app settings ---
# LOG_LEVEL=INFO
# Optional: override Slack OAuth scopes (defaults match slack_manifest_scopes.py)
# SLACK_BOT_SCOPES=
# SLACK_USER_SCOPES=
# The primary workspace Slack ID reserves special privileges, default is empty
# Set the ID to see extra options in that workspace
# PRIMARY_WORKSPACE=
# Whether to expose the database reset button, only visible on primary workspace
# ENABLE_DB_RESET=false
